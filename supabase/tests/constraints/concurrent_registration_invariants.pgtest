set search_path = public, extensions;

delete from public.registrations where event_id in (
  '49100000-0000-4000-8000-000000000001',
  '49100000-0000-4000-8000-000000000002',
  '49100000-0000-4000-8000-000000000003'
);
delete from public.participants where id in (
  '49200000-0000-4000-8000-000000000001',
  '49200000-0000-4000-8000-000000000002',
  '49200000-0000-4000-8000-000000000003'
);
delete from public.events where id in (
  '49100000-0000-4000-8000-000000000001',
  '49100000-0000-4000-8000-000000000002',
  '49100000-0000-4000-8000-000000000003'
);
delete from public.profiles where id = '49900000-0000-4000-8000-000000000001';
delete from auth.users where id = '49900000-0000-4000-8000-000000000001';

insert into auth.users (
  instance_id, id, aud, role, email, confirmation_token, recovery_token,
  email_change, raw_app_meta_data, raw_user_meta_data, created_at, updated_at
) values (
  '00000000-0000-0000-0000-000000000000',
  '49900000-0000-4000-8000-000000000001',
  'authenticated', 'authenticated', 'concurrent-schema@example.test',
  '', '', '', '{}', '{}', now(), now()
);
insert into public.profiles (id, display_name, committee_role) values
  ('49900000-0000-4000-8000-000000000001', 'Concurrent Schema Owner', 'authorised');
insert into public.events (
  id, event_type, name, starts_at, location, description,
  requires_student_id, created_by
) values
  ('49100000-0000-4000-8000-000000000001', 'weekly_session', 'Registration Race Event', now(), 'Test Room', 'Fictional race fixture.', false, '49900000-0000-4000-8000-000000000001'),
  ('49100000-0000-4000-8000-000000000002', 'weekly_session', 'Participant Race Event', now(), 'Test Room', 'Fictional race fixture.', false, '49900000-0000-4000-8000-000000000001'),
  ('49100000-0000-4000-8000-000000000003', 'weekly_session', 'Reverse Registration Race Event', now(), 'Test Room', 'Fictional reverse race fixture.', false, '49900000-0000-4000-8000-000000000001');
insert into public.participants (id, full_name, email, student_id) values
  ('49200000-0000-4000-8000-000000000001', 'Registration Race Participant', 'registration-race@example.test', null),
  ('49200000-0000-4000-8000-000000000002', 'Participant Race Participant', 'participant-race@example.test', 'RACE-0002'),
  ('49200000-0000-4000-8000-000000000003', 'Reverse Registration Race Participant', 'reverse-registration-race@example.test', null);
insert into public.registrations (event_id, participant_id, recorded_by) values
  ('49100000-0000-4000-8000-000000000002', '49200000-0000-4000-8000-000000000002', '49900000-0000-4000-8000-000000000001');

-- 停用后不再竞态切换学号要求；验证并发报名和约束不可重新开启。
select plan(7);
select extensions.dblink_connect_u('registration_first','dbname=postgres user=postgres');
select extensions.dblink_connect_u('registration_second','dbname=postgres user=postgres');
select extensions.dblink_exec('registration_first','begin');
select extensions.dblink_exec('registration_second','begin');
select extensions.dblink_exec('registration_first', $$insert into public.registrations(event_id,participant_id,recorded_by)
 values('49100000-0000-4000-8000-000000000001','49200000-0000-4000-8000-000000000001','49900000-0000-4000-8000-000000000001')$$);
select is(extensions.dblink_send_query('registration_second', $$insert into public.registrations(event_id,participant_id,recorded_by)
 values('49100000-0000-4000-8000-000000000003','49200000-0000-4000-8000-000000000003','49900000-0000-4000-8000-000000000001') returning participant_id::text$$),1,'second registration starts while first transaction is open');
select extensions.dblink_exec('registration_first','commit');
select lives_ok($$select * from extensions.dblink_get_result('registration_second') as result(participant_id text)$$,'second no-ID registration succeeds');
-- Drain the async command before committing this connection.
select * from extensions.dblink_get_result('registration_second') as result(participant_id text);
select extensions.dblink_exec('registration_second','commit');
select is((select count(*)::integer from public.registrations where event_id in ('49100000-0000-4000-8000-000000000001','49100000-0000-4000-8000-000000000003')),2,'both registrations are retained');
select throws_ok($$select extensions.dblink_exec('registration_first', $q$update public.events set requires_student_id=true where id='49100000-0000-4000-8000-000000000001'$q$)$$,'23514',null,'first connection cannot re-enable the requirement');
select throws_ok($$select extensions.dblink_exec('registration_second', $q$update public.events set requires_student_id=true where id='49100000-0000-4000-8000-000000000003'$q$)$$,'23514',null,'second connection cannot re-enable the requirement');
select ok(not exists(select 1 from public.events where requires_student_id),'all requirements remain disabled');
select ok(not exists(select 1 from public.participants where id in ('49200000-0000-4000-8000-000000000001','49200000-0000-4000-8000-000000000003') and student_id is not null),'registration did not invent student IDs');
select extensions.dblink_disconnect('registration_first');
select extensions.dblink_disconnect('registration_second');
delete from public.registrations where event_id in (
  '49100000-0000-4000-8000-000000000001',
  '49100000-0000-4000-8000-000000000002',
  '49100000-0000-4000-8000-000000000003'
);
delete from public.participants where id in (
  '49200000-0000-4000-8000-000000000001',
  '49200000-0000-4000-8000-000000000002',
  '49200000-0000-4000-8000-000000000003'
);
delete from public.events where id in (
  '49100000-0000-4000-8000-000000000001',
  '49100000-0000-4000-8000-000000000002',
  '49100000-0000-4000-8000-000000000003'
);
delete from public.profiles where id = '49900000-0000-4000-8000-000000000001';
delete from auth.users where id = '49900000-0000-4000-8000-000000000001';

select * from finish();
