{
  "name": "mahjongflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test .github/scripts/run-database-tests.test.mjs",
    "test:acceptance": "vitest run tests/acceptance tests/integration/auth tests/unit/auth tests/unit/authorization.test.ts \"src/app/(auth)\" src/components",
    "test:m1": "npm run db:reset:no-seed && npm run db:reset && npm run lint && npm run typecheck && npm test && npm run test:acceptance && npm run db:test && npm run db:test:concurrency && npm run db:lint && npm run db:diff && npm run build",
    "db:start": "supabase start -x vector",
    "db:start:ci": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:reset:no-seed": "supabase db reset --local --no-seed",
    "db:test": "node .github/scripts/run-database-tests.mjs",
    "db:test:concurrency": "pwsh -NoProfile -File supabase/tests/constraints/run_concurrent_registration_invariants.ps1 && pwsh -NoProfile -File supabase/tests/rls/run_concurrent_invariants.ps1",
    "db:migrations": "supabase migration list --local",
    "db:migration:new": "supabase migration new",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:diff": "supabase db diff --local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
