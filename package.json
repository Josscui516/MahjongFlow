{
  "name": "mahjongflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:automation",
    "test:automation": "node --test .github/scripts/project-automation.test.mjs .github/scripts/run-database-tests.test.mjs",
    "test:acceptance": "vitest run tests/acceptance",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:reset:no-seed": "supabase db reset --local --no-seed",
    "db:test": "node .github/scripts/run-database-tests.mjs",
    "db:migrations": "supabase migration list --local",
    "db:migration:new": "supabase migration new",
    "db:lint": "supabase db lint --local --fail-on error",
    "db:diff": "supabase db diff --local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
