# Supabase project URL. Browser-visible; obtain it from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Browser-visible; data access must still be protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase secret key. Leave empty unless an approved narrow server workflow requires it.
# This key bypasses RLS. Never prefix it with NEXT_PUBLIC_, import it into Client Components, or expose it in logs.
SUPABASE_SECRET_KEY=
