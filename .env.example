# Supabase project URL. Browser-visible; obtain it from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Browser-visible; data access must still be protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only Supabase secret key. Leave empty unless an approved narrow server workflow requires it.
# This key bypasses RLS. Never prefix it with NEXT_PUBLIC_, import it into Client Components, or expose it in logs.
SUPABASE_SECRET_KEY=

# Canonical application origin used for invitation and password-recovery redirects.
# Use http://localhost:3000 locally and HTTPS in deployed environments.
APP_BASE_URL=

# Optional local Docker transport. start-local.ps1/compose.yaml configure these.
# Leave unset for normal hosted Supabase deployments.
NEXT_PUBLIC_SUPABASE_SAME_ORIGIN=
LOCAL_DOCKER_HOST_IP=
